FROM golang:1.26.1-alpine

WORKDIR /app

RUN --mount=type=cache,target=/go/pkg/mod \
    go install github.com/air-verse/air@v1.67.4

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .

RUN chmod +x refresh.sh && ./refresh.sh

EXPOSE 8080

CMD ["air", "-c", ".air.toml"]
